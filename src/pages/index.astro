---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { ui } from '../i18n/ui';

const posts = (await getCollection('blog')).filter((post) => post.id.startsWith('en/'));
const latest = posts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout>
	<section class="hero">
		<p class="mono kicker">{ui.en['home.kicker']}</p>
		<h1>Mickaël KENAN.</h1>
		<p class="tagline">{ui.en['home.tagline']}</p>
		<p class="intro">{ui.en['home.intro']}</p>
		<div class="actions">
			<a class="btn" href={site.social.github} rel="me">{ui.en['home.github']}</a>
			<a class="btn ghost" href={site.social.linkedin} rel="me">{ui.en['home.linkedin']}</a>
		</div>
	</section>

	<section class="latest">
		<div class="latest-head">
			<p class="mono kicker">{ui.en['home.latest']}</p>
			<a class="all" href="/blog/">{ui.en['home.all']}</a>
		</div>
		<ul class="posts">
			{
				latest.map((post) => (
					<li>
						<a class="post" href={`/blog/${post.id.slice(3)}/`}>
							<time datetime={post.data.pubDate.toISOString()}>
								{formatDate(post.data.pubDate)}
							</time>
							<h2>{post.data.title}</h2>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		max-width: 64rem;
		margin: 0 auto;
		padding: 6rem 2rem;
	}

	.kicker {
		color: var(--accent);
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.tagline {
		font-size: clamp(1.5rem, 5vw, 2.5rem);
		color: var(--muted);
		margin-bottom: 1.5rem;
	}

	.intro {
		max-width: 36rem;
		color: var(--muted);
		margin-bottom: 2.5rem;
	}

	.actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		padding: 0.6rem 1.25rem;
		border: 1px solid var(--accent);
		border-radius: 0.375rem;
		color: var(--accent);
		font-size: 0.925rem;
	}

	.btn:hover {
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		text-decoration: none;
	}

	.btn.ghost {
		border-color: var(--border);
		color: var(--text);
	}

	.btn.ghost:hover {
		background: var(--surface);
	}

	.latest {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0 2rem 4rem;
	}

	.latest-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.kicker {
		color: var(--accent);
		font-size: 0.9rem;
		margin: 0;
	}

	.all {
		font-size: 0.875rem;
		color: var(--muted);
	}

	.posts {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.post {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		color: var(--text);
	}

	.post:hover {
		border-color: var(--accent);
		text-decoration: none;
	}

	.post time {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
		flex-shrink: 0;
	}

	.post h2 {
		font-size: 1rem;
		font-weight: 500;
	}

	@media (max-width: 40rem) {
		.post {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
