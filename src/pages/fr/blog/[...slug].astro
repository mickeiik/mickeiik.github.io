---
import ArticleView from '../../../views/ArticleView.astro';
import { getPosts, postSlug } from '../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts('fr');
	return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<ArticleView post={post} lang="fr" />
