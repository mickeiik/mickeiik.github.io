---
import Tile from '../ui/Tile.astro';
import NowPlaying from '../music/NowPlaying.astro';
import type { Track } from '../../lib/live';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
	track: Track;
	lang: Lang;
	delay?: number;
}

const { track, lang, delay } = Astro.props;
const t = useTranslations(lang);
---

<Tile cols={2} delay={delay} animate="enter-fast" class="now-playing-tile" aria-label={t('music.player')}>
	<NowPlaying track={track} lang={lang} />
</Tile>

<style>
	.now-playing-tile {
		display: flex;
		align-items: center;
		padding: var(--space-7);
		overflow: hidden;
	}

	@media (max-width: 760px) {
		.now-playing-tile {
			padding: var(--space-6);
		}
	}
</style>
