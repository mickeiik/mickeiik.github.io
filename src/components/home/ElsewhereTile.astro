---
import Tile from '../ui/Tile.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
	lang: Lang;
	delay?: number;
}

const { lang, delay } = Astro.props;
const t = useTranslations(lang);
---

<Tile as="nav" delay={delay} animate="enter-fast" phoneFull class="elsewhere" aria-label={t('home.elsewhere')}>
	<p class="mono label">{t('home.elsewhere')}</p>
	<div class="links">
		<Button href={site.social.github} icon="github" iconOnly label="GitHub" rel="me" />
		<Button href={site.social.linkedin} icon="linkedin" iconOnly label="LinkedIn" rel="me" />
		<Button href={site.social.email} icon="mail" iconOnly label={t('home.email')} />
	</div>
</Tile>

<style>
	.elsewhere {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.label {
		font-size: var(--text-xs);
		color: var(--color-periwinkle);
	}

	.links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-2);
	}

	/* On phones the tile is just the row of icons. */
	@media (max-width: 760px) {
		.elsewhere {
			padding: 0;
			border: 0;
			background: none;
		}

		.label {
			display: none;
		}

		.links :global(.button) {
			border: 1px solid var(--color-border);
			background: var(--color-surface);
			border-radius: 18px;
		}
	}
</style>
