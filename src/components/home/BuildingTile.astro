---
import Tile from '../ui/Tile.astro';
import Icon from '../ui/Icon.astro';
import { building } from '../../data/home';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
	lang: Lang;
	delay?: number;
}

const { lang, delay } = Astro.props;
const t = useTranslations(lang);
---

<Tile href={building.href} as="section" delay={delay} animate="enter-fast" class="building" aria-label={t('home.building')}>
	<p class="mono command">$ {building.name.toLowerCase()} status</p>
	<div>
		<p class="name display">{building.name}</p>
		<p class="status mono">
			<Icon name="spinner" size={14} strokeWidth={2.5} class="spinner" />
			{building.status[lang]}
		</p>
	</div>
</Tile>

<style>
	.building {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.command {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.name {
		font-size: 1.875rem;
		line-height: 1;
	}

	.status {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: 10px;
		font-size: var(--text-sm);
		color: var(--color-mint);
	}

	.status :global(.spinner) {
		flex: none;
		animation: spin 1.2s linear infinite;
	}

	@media (max-width: 760px) {
		.building {
			min-height: 150px;
			padding: 18px;
		}

		.name {
			font-size: var(--text-xl);
		}

		.status {
			font-size: var(--text-2xs);
		}
	}
</style>
