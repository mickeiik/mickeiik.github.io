---
/** Four-column bento grid (two columns on phones). Tiles choose their own span. */
---

<div class="bento">
	<slot />
</div>

<style>
	.bento {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-auto-flow: dense;
		gap: var(--grid-gap);
	}

	/* Tiles can lower this with --tile-min-height (e.g. the "All writing" bar). */
	.bento > :global(*) {
		min-height: var(--tile-min-height, 210px);
	}

	@media (max-width: 760px) {
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.bento > :global(*) {
			min-height: 0;
		}
	}
</style>
