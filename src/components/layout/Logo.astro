---
import { site } from '../../data/site';

interface Props {
	href: string;
	label: string;
	/** Hide the "~/mickael" wordmark (used in the compact phone header). */
	compact?: boolean;
}

const { href, label, compact = false } = Astro.props;
---

<a class="logo" href={href} aria-label={label}>
	<span class="mark" aria-hidden="true">mk</span>
	{
		!compact && (
			<span class="wordmark display" aria-hidden="true">
				<span class="mono">~/</span>
				{site.handle}
			</span>
		)
	}
</a>

<style>
	.logo {
		display: flex;
		flex: none;
		align-items: center;
		gap: var(--space-3);
		min-height: var(--tap-target);
	}

	.mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: var(--radius-sm);
		background: var(--color-lime);
		color: var(--color-ink);
		font-family: var(--font-display), sans-serif;
		font-size: var(--text-base);
		font-weight: 800;
		letter-spacing: -0.02em;
		transition: transform 0.35s var(--ease-pop);
	}

	.logo:hover .mark {
		transform: rotate(-8deg) scale(1.06);
	}

	.wordmark {
		font-size: 1.25rem;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.wordmark .mono {
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--color-activity-3);
	}

	/* On phones the header keeps only the mark, leaving room for the navigation pill. */
	@media (max-width: 760px) {
		.mark {
			width: 40px;
			height: 40px;
		}

		.wordmark {
			display: none;
		}
	}
</style>
