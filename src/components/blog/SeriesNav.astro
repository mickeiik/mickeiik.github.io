---
import Tile from '../ui/Tile.astro';
import { postUrl, type Post, type SeriesInfo } from '../../lib/posts';
import { localizePath, useTranslations, type Lang } from '../../i18n/utils';

/** "In this series" card on an article, with the reader's progress through the parts. */
interface Props {
	series: SeriesInfo;
	current: Post;
	lang: Lang;
	delay?: number;
}

const { series, current, lang, delay } = Astro.props;
const t = useTranslations(lang);
const index = series.parts.findIndex((part) => part.id === current.id);
const progress = ((index + 1) / series.parts.length) * 100;
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<Tile as="nav" padding="sm" delay={delay} animate="enter-fast" class="series-nav" aria-label={t('post.inSeries')}>
	<div class="head">
		<p class="mono label">{t('post.inSeries')}</p>
		<p class="position">{t('post.partOfShort', { part: index + 1, total: series.parts.length })}</p>
	</div>
	<a class="display title" href={`${localizePath('/blog/', lang)}?series=${series.id}`}>{series.title}</a>
	<div class="progress" aria-hidden="true"><span style={`width: ${progress}%`}></span></div>
	<ol>
		{
			series.parts.map((part, i) =>
				part.id === current.id ? (
					<li class="item is-current" aria-current="page">
						<span class="num mono">{number(i)}</span>
						{part.data.title}
					</li>
				) : (
					<li>
						<a class="item" href={postUrl(part)}>
							<span class="num mono">{number(i)}</span>
							{part.data.title}
						</a>
					</li>
				),
			)
		}
	</ol>
</Tile>

<style>
	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.label {
		font-size: var(--text-xs);
		color: var(--color-periwinkle);
	}

	.position {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.title {
		display: block;
		margin-top: 6px;
		font-size: var(--text-lg);
	}

	.progress {
		height: 4px;
		margin: 14px 0;
		border-radius: 2px;
		background: var(--color-control);
	}

	.progress span {
		display: block;
		height: 100%;
		border-radius: 2px;
		background: var(--color-periwinkle);
	}

	ol {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 0;
		list-style: none;
	}

	.item {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 48px;
		padding: 6px 12px;
		border-radius: var(--radius-md);
		color: var(--color-text-body);
		line-height: 1.3;
		transition:
			background-color var(--duration-fast),
			transform 0.25s var(--ease-spring);
	}

	a.item:hover {
		background: var(--color-hover-row);
		color: var(--color-text);
		transform: translateX(4px);
	}

	.num {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border: 1px solid var(--color-border-strong);
		border-radius: 50%;
		font-size: var(--text-xs);
		transition:
			background-color var(--duration-fast),
			color var(--duration-fast),
			border-color var(--duration-fast);
	}

	a.item:hover .num,
	.is-current .num {
		border-color: var(--color-periwinkle);
		background: var(--color-periwinkle);
		color: var(--color-ink);
	}

	.is-current {
		background: var(--color-control);
		color: var(--color-text);
		font-weight: 600;
	}
</style>
