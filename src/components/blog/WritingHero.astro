---
import Tile from '../ui/Tile.astro';
import Prompt from '../ui/Prompt.astro';
import Icon from '../ui/Icon.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Tile tone="lime" padding="lg" radius="xl" delay={0.05} animate="enter-fast" class="hero">
	<div class="copy">
		<Prompt path={lang === 'fr' ? '~/articles' : '~/writing'} command="ls" tone="ink" class="hero-prompt" />
		<h1 class="display">{t('writing.title')}</h1>
		<p class="intro">{t('writing.intro')}</p>
	</div>
	<form class="search" role="search" data-writing-search>
		<label for="writing-query" class="mono">{t('writing.search')}</label>
		<div class="field">
			<Icon name="search" size={18} strokeWidth={2} />
			<input id="writing-query" class="mono" type="search" name="q" placeholder={t('writing.searchPlaceholder')} autocomplete="off" />
		</div>
	</form>
</Tile>

<style>
	.hero {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-7) var(--space-12);
	}

	.copy {
		flex: 1 1 380px;
		min-width: 0;
	}

	.hero :global(.hero-prompt) {
		font-size: 0.875rem;
		color: var(--color-on-lime-muted);
	}

	h1 {
		margin-top: 18px;
		font-size: clamp(3rem, 7vw, 5.5rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
	}

	.intro {
		max-width: 34rem;
		margin-top: var(--space-4);
		font-size: var(--text-md);
		line-height: 1.45;
		color: var(--color-on-lime-soft);
	}

	.search {
		flex: 0 1 380px;
		min-width: 0;
	}

	label {
		display: block;
		margin-bottom: var(--space-2);
		font-size: var(--text-sm);
	}

	.field {
		position: relative;
		color: var(--color-text-muted);
	}

	.field :global(svg) {
		position: absolute;
		left: 16px;
		top: 15px;
	}

	input {
		width: 100%;
		height: 48px;
		padding: 0 16px 0 46px;
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--color-ink);
		color: var(--color-text);
		font-size: 0.875rem;
		outline: none;
	}

	input::placeholder {
		color: var(--color-text-faint);
	}

	input:focus-visible {
		box-shadow:
			0 0 0 3px var(--color-ink),
			0 0 0 5px var(--color-text);
	}

	@media (max-width: 760px) {
		.hero {
			gap: var(--space-5);
		}

		h1 {
			font-size: 3.25rem;
		}

		.intro {
			font-size: var(--text-base);
		}

		.search {
			flex-basis: 100%;
		}
	}
</style>
