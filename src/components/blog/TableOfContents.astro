---
import type { MarkdownHeading } from 'astro';
import Tile from '../ui/Tile.astro';
import Icon from '../ui/Icon.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

/**
 * "On this page" navigation built from the article's h2 headings.
 * A highlight slides to the section being read (src/scripts/toc.ts).
 * On phones it collapses into a disclosure.
 */
interface Props {
	headings: MarkdownHeading[];
	lang: Lang;
	delay?: number;
}

const { headings, lang, delay } = Astro.props;
const t = useTranslations(lang);
const sections = headings.filter((heading) => heading.depth === 2);
const number = (i: number) => String(i + 1).padStart(2, '0');
---

{
	sections.length > 1 && (
		<Tile as="nav" padding="none" delay={delay} animate="enter-fast" class="toc" aria-label={t('post.onThisPage')} data-toc>
			<details open>
				<summary class="mono">
					<span>
						{t('post.onThisPage')}
						<span class="current" data-toc-current>
							· {number(0)}
						</span>
					</span>
					<Icon name="chevron-down" size={18} strokeWidth={2} class="chevron" />
				</summary>
				<div class="items">
					<span class="highlight" aria-hidden="true" data-toc-highlight />
					<span class="bar" aria-hidden="true" data-toc-highlight />
					{sections.map((heading, i) => (
						<a href={`#${heading.slug}`} data-toc-link={heading.slug} aria-current={i === 0 ? 'location' : undefined}>
							<span class="mono number">{number(i)}</span>
							{heading.text}
						</a>
					))}
				</div>
			</details>
		</Tile>
	)
}

<style>
	.toc {
		padding: 18px 12px 14px;
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 12px 10px;
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		list-style: none;
		cursor: default;
		pointer-events: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary :global(.chevron),
	.current {
		display: none;
	}

	.items {
		position: relative;
	}

	.highlight,
	.bar {
		position: absolute;
		left: 0;
		top: 0;
		transform: translateY(var(--toc-y, 0));
		transition: transform 0.45s cubic-bezier(0.3, 1.2, 0.5, 1);
	}

	.highlight {
		right: 0;
		height: 40px;
		border-radius: var(--radius-sm);
		background: var(--color-control);
	}

	.bar {
		top: 10px;
		width: 3px;
		height: 20px;
		border-radius: 2px;
		background: var(--color-lime);
	}

	a {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 40px;
		margin-bottom: 2px;
		padding: 0 12px;
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
		line-height: 1.25;
		transition: color 0.3s;
	}

	a[aria-current='location'] {
		color: var(--color-text);
	}

	.number {
		flex: none;
		margin-right: 10px;
		font-size: var(--text-xs);
		color: var(--color-text-ghost);
		transition: color 0.3s;
	}

	a[aria-current='location'] .number {
		color: var(--color-lime);
	}

	@media (max-width: 760px) {
		.toc {
			padding: 6px;
			border-radius: 22px;
		}

		summary {
			min-height: var(--tap-target);
			padding: 0 12px;
			font-size: var(--text-sm);
			cursor: pointer;
			pointer-events: auto;
		}

		summary :global(.chevron) {
			display: block;
			transition: transform 0.3s;
		}

		details[open] summary :global(.chevron) {
			transform: rotate(180deg);
		}

		.current {
			display: inline;
			color: var(--color-lime);
		}

		.items {
			padding: 2px 0 4px;
		}

		a,
		.highlight {
			min-height: 44px;
			height: 44px;
		}

		.bar {
			top: 12px;
		}
	}
</style>
