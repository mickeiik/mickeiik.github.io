---
import NowPlaying from './NowPlaying.astro';
import type { Track } from '../../lib/live';
import type { Lang } from '../../i18n/utils';

/**
 * Phone-only full player, opened from the mini player in the header.
 * It sits at the top of the page content and persists across navigations.
 */
interface Props {
	track: Track;
	lang: Lang;
}

const { track, lang } = Astro.props;
---

<div class="player-panel" data-player hidden transition:persist={`player-panel-${lang}`}>
	<div class="player-card">
		<NowPlaying track={track} lang={lang} size="compact" />
	</div>
</div>

<style>
	.player-panel {
		padding-bottom: var(--space-3);
	}

	.player-panel[data-state='open'] .player-card {
		animation: panel-open 0.5s var(--ease-emphasis) both;
	}

	.player-panel[data-state='closing'] {
		animation: panel-collapse 0.32s var(--ease-in-out) both;
	}

	@keyframes panel-open {
		from {
			opacity: 0;
			max-height: 0;
			transform: translateY(-14px) scale(0.97);
			padding-block: 0;
		}
		to {
			max-height: 320px;
		}
	}

	@keyframes panel-collapse {
		from {
			max-height: 320px;
		}
		to {
			opacity: 0;
			max-height: 0;
			transform: translateY(-14px) scale(0.97);
			padding-bottom: 0;
		}
	}

	.player-card {
		overflow: hidden;
		padding: 18px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
	}

	@media (min-width: 761px) {
		.player-panel {
			display: none;
		}
	}
</style>
