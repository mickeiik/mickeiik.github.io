---
import { musicUrl, type Track } from '../../lib/live';
import { useTranslations, type Lang } from '../../i18n/utils';

/**
 * Music player card. It always renders "stopped" (no autoplay); the play button switches every
 * player on the page to "now playing" through src/scripts/music.ts.
 * Without an audio source there is nothing to play, so the button and seek bar are disabled.
 * With the live Worker, src/scripts/music-live.ts keeps the track and the presence line
 * ("listening now" / "played 2 hours ago") in sync with the phone.
 * Title and meta stay on one line; when one is cut, hovering it shows the full text.
 * On phones it keeps the same layout, scaled down.
 */
interface Props {
	track: Track;
	lang: Lang;
}

const { track, lang } = Astro.props;
const t = useTranslations(lang);
const playable = Boolean(track.audioUrl);
const formatTime = (ms: number) => `${Math.floor(ms / 60_000)}:${String(Math.floor(ms / 1000) % 60).padStart(2, '0')}`;
---

<div
	class="now-playing"
	data-now-playing
	data-state="stopped"
	data-duration={track.durationMs}
	data-audio-src={track.audioUrl}
	data-live-src={musicUrl}
>
	<div class="record" data-track-art data-cover={track.artworkUrl ? '' : undefined} aria-hidden="true">
		<div class="disc">
			<div class="label"><span class="hole"></span></div>
		</div>
		{track.artworkUrl && <img class="sleeve" src={track.artworkUrl} alt="" />}
	</div>
	<div class="info">
		<div class="status-row">
			<p class="status mono">
				<span class="dot"></span>
				<span data-player-status data-label-stopped={t('music.stopped')} data-label-playing={t('music.nowPlaying')}>
					{t('music.stopped')}
				</span>
			</p>
			<span class="equalizer" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
		</div>
		<p class="title display" data-clipped-line><span class="clip" data-track-title>{track.title}</span></p>
		<p class="meta" data-clipped-line>
			<span class="clip" data-track-meta>{[track.artist, track.album].filter(Boolean).join(' · ')}</span>
		</p>
		{
			track.playedAt && (
				<p
					class="presence mono"
					data-music-presence
					data-live={track.live ? 'true' : undefined}
					data-played-at={track.playedAt}
					data-label-live={t('music.live')}
					data-label-played={t('music.lastPlayed')}
				>
					<span class="presence-dot" aria-hidden="true" />
					<span class="presence-text" data-presence-text />
				</p>
			)
		}
		<div class="controls">
			<button
				type="button"
				class="control"
				data-player-toggle-playback
				disabled={!playable}
				aria-pressed="false"
				aria-label={t('music.play')}
				data-label-play={t('music.play')}
				data-label-pause={t('music.pause')}
			>
				<svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M7 4.5v15l13-7.5z" />
				</svg>
				<svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<rect x="6" y="5" width="4" height="14" rx="1" />
					<rect x="14" y="5" width="4" height="14" rx="1" />
				</svg>
			</button>
			<div class="seek" data-player-seek-wrap>
				<input
					type="range"
					class="seek-input"
					data-player-seek
					min="0"
					max={track.durationMs ?? 0}
					step="1000"
					value="0"
					disabled={!playable}
					aria-label={t('music.seek')}
					aria-valuetext={`0:00 / ${formatTime(track.durationMs ?? 0)}`}
				/>
				<span class="seek-tip mono" data-player-seek-tip aria-hidden="true">0:00</span>
			</div>
		</div>
	</div>
</div>

<script>
	import '../../scripts/music';
	import '../../scripts/music-live';
</script>

<style>
	.now-playing {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		width: 100%;
		min-width: 0;
	}

	/*
	 * The record. With a cover, the full cover is shown as its sleeve and the record peeks out
	 * on the right; it slides further out while playing. Without one, the record stands alone.
	 * Both take the same width (--box): with a cover, the sleeve shrinks so the peeking record fits.
	 */
	.record {
		--box: 140px;
		--size: var(--box);
		position: relative;
		flex: none;
		width: var(--box);
		height: var(--size);
	}

	.record[data-cover] {
		--size: calc(var(--box) / 1.2);
	}

	.disc {
		position: absolute;
		top: 0;
		left: 0;
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: repeating-radial-gradient(circle, var(--color-groove-light) 0 2px, var(--color-groove-dark) 2px 5px);
		box-shadow: 0 0 0 1px var(--color-border-raised);
		animation: spin 5s linear infinite;
		transition: translate var(--duration-slow) var(--ease-spring);
	}

	.record[data-cover] .disc {
		translate: 12% 0;
	}

	[data-state='playing'] .record[data-cover] .disc {
		translate: 20% 0;
	}

	/* Global: the script swaps the cover when the track changes, and its element has no scoped attribute. */
	.record :global(.sleeve) {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 1;
		width: var(--size);
		height: var(--size);
		border-radius: var(--radius-sm);
		object-fit: cover;
		box-shadow:
			0 0 0 1px var(--color-border-raised),
			6px 0 16px color-mix(in srgb, var(--color-ink) 70%, transparent);
		animation: sleeve-in var(--duration-base) var(--ease-out);
	}

	@keyframes sleeve-in {
		from {
			opacity: 0;
			transform: scale(0.94);
		}
	}

	.label {
		width: 37%;
		height: 37%;
		overflow: hidden;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: conic-gradient(
			var(--color-lime) 0 25%,
			var(--color-periwinkle) 0 50%,
			var(--color-coral) 0 75%,
			var(--color-mint) 0
		);
	}

	.hole {
		width: 16%;
		height: 16%;
		border-radius: 50%;
		background: var(--color-ink);
	}

	.info {
		flex: 1;
		min-width: 0;
	}

	.status-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: var(--text-xs);
		color: var(--color-lime);
		white-space: nowrap;
		transition: color 0.3s;
	}

	.dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: currentColor;
		animation: pulse-ring 1.6s ease-out infinite;
	}

	.equalizer {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 24px;
	}

	.equalizer i {
		width: 4px;
		height: 20%;
		border-radius: 2px;
		background: var(--color-lime);
		animation: equalizer 1.1s ease-in-out infinite;
		transition: background-color 0.3s;
	}

	.equalizer i:nth-child(2) {
		animation-delay: 0.25s;
	}
	.equalizer i:nth-child(3) {
		animation-delay: 0.5s;
	}
	.equalizer i:nth-child(4) {
		animation-delay: 0.12s;
	}
	.equalizer i:nth-child(5) {
		animation-delay: 0.38s;
	}

	.title {
		margin-top: var(--space-3);
		font-size: var(--text-xl);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.meta {
		margin-top: var(--space-1);
		color: var(--color-text-muted);
	}

	/* One line each. The inner span clips, so the line itself can hold the full-text tip. */
	[data-clipped-line] {
		position: relative;
	}

	.clip {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* Full text of a cut line, set by src/scripts/music.ts only when the line is actually cut. */
	[data-clipped-line][data-full]::after {
		content: attr(data-full);
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		z-index: 2;
		width: max-content;
		max-width: 100%;
		padding: 6px 10px;
		border-radius: var(--radius-xs);
		background: var(--color-text);
		color: var(--color-ink);
		font-family: var(--font-body), ui-sans-serif, system-ui, sans-serif;
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.35;
		letter-spacing: normal;
		white-space: normal;
		opacity: 0;
		pointer-events: none;
		transform: translateY(4px);
		transition:
			opacity 0.15s,
			transform 0.15s var(--ease-out);
	}

	@media (hover: hover) {
		[data-clipped-line][data-full]:hover::after {
			opacity: 1;
			transform: none;
		}
	}

	/* Is the phone playing right now. Filled in by the script, since a build-time relative time goes stale. */
	.presence {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: var(--space-2);
		font-size: var(--text-xs);
		color: var(--color-text-faint);
		transition: color 0.3s;
	}

	.presence:not([data-ready]) {
		visibility: hidden;
	}

	.presence-dot {
		display: none;
		flex: none;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
		animation: pulse-ring 1.6s ease-out infinite;
	}

	.presence[data-live] {
		color: var(--color-lime);
	}

	.presence[data-live] .presence-dot {
		display: block;
	}

	.presence-text {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 18px;
	}

	.control {
		flex: none;
		width: var(--tap-target);
		height: var(--tap-target);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--color-text);
		color: var(--color-ink);
		transition: transform var(--duration-fast);
	}

	.control:disabled {
		background: var(--color-control);
		color: var(--color-text-faint);
		cursor: not-allowed;
	}

	.control:enabled:hover {
		transform: scale(1.06);
	}

	.control:enabled:active {
		transform: scale(0.94);
	}

	/* Seek bar: a range input drawn as the prototype's thin bar, with a thumb on hover. */
	.seek {
		position: relative;
		flex: 1;
		display: flex;
		align-items: center;
		min-width: 0;
	}

	.seek-input {
		--progress: 0%;
		width: 100%;
		height: 20px;
		margin: 0;
		background: transparent;
		cursor: pointer;
		-webkit-appearance: none;
		appearance: none;
	}

	.seek-input:disabled {
		cursor: default;
	}

	.seek-input::-webkit-slider-runnable-track {
		height: 4px;
		border-radius: 2px;
		background: linear-gradient(to right, var(--color-text) var(--progress), var(--color-border-raised) var(--progress));
	}

	.seek-input::-moz-range-track {
		height: 4px;
		border-radius: 2px;
		background: linear-gradient(to right, var(--color-text) var(--progress), var(--color-border-raised) var(--progress));
	}

	.seek-input::-webkit-slider-thumb {
		width: 12px;
		height: 12px;
		margin-top: -4px;
		border: 0;
		border-radius: 50%;
		background: var(--color-text);
		transform: scale(0);
		transition: transform 0.15s var(--ease-out);
		-webkit-appearance: none;
		appearance: none;
	}

	.seek-input::-moz-range-thumb {
		width: 12px;
		height: 12px;
		border: 0;
		border-radius: 50%;
		background: var(--color-text);
		transform: scale(0);
		transition: transform 0.15s var(--ease-out);
	}

	.seek:hover .seek-input:enabled::-webkit-slider-thumb,
	.seek-input:focus-visible::-webkit-slider-thumb,
	.seek.is-seeking .seek-input::-webkit-slider-thumb {
		transform: scale(1);
	}

	.seek:hover .seek-input:enabled::-moz-range-thumb,
	.seek-input:focus-visible::-moz-range-thumb,
	.seek.is-seeking .seek-input::-moz-range-thumb {
		transform: scale(1);
	}

	.seek-input:focus-visible {
		outline: none;
	}

	.seek:has(.seek-input:focus-visible) {
		border-radius: 4px;
		outline: 2px solid var(--color-lime);
		outline-offset: 4px;
	}

	/* Time under the pointer, shown while hovering or dragging. */
	.seek-tip {
		position: absolute;
		bottom: calc(100% + 4px);
		left: var(--tip-x, 0px);
		padding: 3px 8px;
		border-radius: var(--radius-xs);
		background: var(--color-text);
		color: var(--color-ink);
		font-size: var(--text-2xs);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transform: translateX(-50%) translateY(4px);
		transition:
			opacity 0.15s,
			transform 0.15s var(--ease-out);
	}

	@media (hover: hover) {
		.seek:hover:has(.seek-input:enabled) .seek-tip {
			opacity: 1;
			transform: translateX(-50%);
		}
	}

	.seek.is-seeking .seek-tip {
		opacity: 1;
		transform: translateX(-50%);
	}

	/* Stopped: the record, dot and equalizer rest; the button offers play. */
	[data-state='playing'] .icon-play,
	[data-state='stopped'] .icon-pause {
		display: none;
	}

	[data-state='stopped'] .status {
		color: var(--color-text-muted);
	}

	[data-state='stopped'] :is(.disc, .equalizer i) {
		animation-play-state: paused;
	}

	[data-state='stopped'] .dot {
		animation: none;
	}

	[data-state='stopped'] .equalizer i {
		background: var(--color-control-hover);
	}

	/* Phones: the same layout as the homepage tile, scaled down. */
	@media (max-width: 760px) {
		.now-playing {
			gap: var(--space-4);
		}

		/* Shrinks a little on the narrowest phones so the seek bar keeps its room. */
		.record {
			--box: clamp(72px, 22vw, 92px);
		}

		.title {
			margin-top: var(--space-2);
			font-size: var(--text-lg);
		}

		.meta {
			font-size: 0.875rem;
		}

		.controls {
			gap: 10px;
			margin-top: var(--space-3);
		}

		.equalizer {
			height: 18px;
		}

		.equalizer i {
			width: 3px;
		}
	}
</style>
