---
import { site } from '../data/site';
import { ui, defaultLang, languages } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;

const lang = Astro.currentLocale ?? defaultLang;
const t = ui[lang as keyof typeof ui];

const localePrefix = (path: string) => (lang === defaultLang ? path : `/${lang}${path}`);
const navItems = [
	{ label: t['nav.home'], href: localePrefix('/') },
	{ label: t['nav.blog'], href: localePrefix('/blog/') },
];

const otherLang = lang === defaultLang ? 'fr' : defaultLang;
const pathWithoutLocale =
	lang === defaultLang
		? Astro.url.pathname
		: Astro.url.pathname.replace(new RegExp(`^/${lang}(?=/|$)`), '');
const switchUrl =
	otherLang === defaultLang ? pathWithoutLocale || '/' : `/${otherLang}${pathWithoutLocale || '/'}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description ?? site.description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="nav">
			<a class="brand" href={localePrefix('/')}>
				<span class="mono">MK</span>
				<span>{site.title}</span>
			</a>
			<nav>
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class:list={{ active: Astro.url.pathname === item.href }}
						>
							{item.label}
						</a>
					))
				}
				<a class="lang" href={switchUrl}>{languages[otherLang as keyof typeof languages]}</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="footer">
			<nav>
				<a href={site.social.github} rel="me">GitHub</a>
				<a href={site.social.linkedin} rel="me">LinkedIn</a>
				<a href={site.social.email}>Email</a>
			</nav>
			<p>© {new Date().getFullYear()} {site.title}</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0b0b0d;
		--surface: #141417;
		--border: #232327;
		--text: #e8e8ea;
		--muted: #8f8f96;
		--accent: #7dd3a8;
		--font-mono: ui-monospace, 'JetBrains Mono', Menlo, monospace;
	}

	* {
		margin: 0;
		box-sizing: border-box;
	}

	html {
		color-scheme: dark;
	}

	body {
		background: var(--bg);
		color: var(--text);
		font-family: ui-sans-serif, -apple-system, 'Segoe UI', Roboto, sans-serif;
		line-height: 1.6;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	a {
		color: var(--accent);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.mono {
		font-family: var(--font-mono);
	}

	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem 2rem;
		max-width: 64rem;
		width: 100%;
		margin: 0 auto;
		background: var(--bg);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--text);
		font-weight: 600;
	}

	.brand .mono {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		font-size: 0.75rem;
		color: var(--accent);
	}

	.nav nav {
		display: flex;
		gap: 1.5rem;
	}

	.nav nav a {
		color: var(--muted);
		font-size: 0.925rem;
	}

	.nav nav a:hover,
	.nav nav a.active {
		color: var(--text);
	}

	.nav nav a.lang {
		color: var(--accent);
	}

	main {
		flex: 1;
	}

	.footer {
		max-width: 64rem;
		width: 100%;
		margin: 0 auto;
		padding: 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid var(--border);
	}

	.footer nav {
		display: flex;
		gap: 1.5rem;
	}

	.footer p {
		color: var(--muted);
		font-size: 0.875rem;
	}

	@media (max-width: 40rem) {
		.nav,
		.footer {
			flex-direction: column;
			gap: 1rem;
			align-items: flex-start;
		}
	}
</style>
