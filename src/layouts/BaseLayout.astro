---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { site, type NavKey } from '../data/site';
import { otherLang, translatePath, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	/** Highlighted entry in the main navigation. */
	nav?: NavKey;
	/** Page kind, exposed as html[data-page] for page-specific chrome (e.g. the reading bar). */
	page?: 'home' | 'writing' | 'article' | 'not-found';
	/** URL of this page in the other language. Defaults to the mirrored route. */
	alternateUrl?: string;
}

const { lang, title, description = site.description, nav, page, alternateUrl } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const other = otherLang(lang);
const alternate = alternateUrl ?? translatePath(Astro.url.pathname, lang, other);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} data-nav={nav} data-page={page} transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Fixes the cascade layer order before any bundled stylesheet, whatever order they load in (src/styles/global.css). -->
		<style is:inline>
			@layer base, ui, utilities;
		</style>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0c0f" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang={other} href={new URL(alternate, Astro.site)} data-lang-alternate />
		<title>{pageTitle}</title>
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<ClientRouter fallback="none" />
	</head>
	<body>
		<SiteHeader lang={lang} active={nav} alternateUrl={alternate} />
		<main class="page">
			<slot />
		</main>
		<SiteFooter lang={lang} />
	</body>
</html>

<style>
	main {
		flex: 1;
		padding-top: var(--space-5);
	}
</style>
